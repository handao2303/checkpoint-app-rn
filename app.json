{
  "expo": {
    "name": "Checkpoint",
    "slug": "checkpoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "checkpoint",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#FFF8F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "space.checkpoint.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "space.checkpoint.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F1"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "space.checkpoint.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Checkpoint needs camera access to capture check-in photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Checkpoint needs photo library access to upload profile photos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Checkpoint needs location access to show nearby places and record check-ins."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Checkpoint to access your photos.",
          "savePhotosPermission": "Allow Checkpoint to save photos."
        }
      ],
      "expo-web-browser",
      "@react-native-firebase/app",
      "expo-localization",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "a2816f9e-900d-4251-9af0-950a1c92a8ad"
      }
    },
    "owner": "uitbestteam"
  }
}
